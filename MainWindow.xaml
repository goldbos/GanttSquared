<Window x:Class="GanttSquared.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GanttSquared.ViewModels"
        xmlns:conv="clr-namespace:GanttSquared.Converters"
        Title="GanttSquared" Height="720" Width="1280"
        Background="#FF17181C">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF1E1F24"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#FF24252B"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#FF34353D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFE8E9ED"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9AA0AC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF3B82F6"/>
        <SolidColorBrush x:Key="RowAltBrush" Color="#FF212227"/>

        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="6,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF2E2F37"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2A2B32"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF34353D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF2A2B32"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Background="{TemplateBinding Background}"
                                          BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource MutedTextBrush}"
                                                      StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center" HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush2}"
                                        BorderThickness="1" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                                        SnapsToDevicePixels="True">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#FF2A2B32"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FF3A3B42"/>
        </Style>

        <!-- Recursive template for the hierarchical task tree -->
        <HierarchicalDataTemplate x:Key="TaskNodeTemplate" DataType="{x:Type vm:TaskNodeViewModel}"
                                   ItemsSource="{Binding Children}">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="9" Height="9" Fill="#FF6B7280" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter Property="Fill" Value="#FFF4B740"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Path Grid.Column="0" Width="9" Height="9" Fill="#FF60A5FA" Stretch="Uniform"
                      Data="M 0.5,0.5 L 1,0 L 1.5,0.5 L 1,1 Z" VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMilestone}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0"
                           Foreground="#FFE8E9ED" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding DateRangeText}" Margin="10,0,4,0"
                           Foreground="#FF9AA0AC" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </HierarchicalDataTemplate>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Left icon rail -->
        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource RailButton}" Command="{Binding NewTaskCommand}" ToolTip="New Task (Ins)">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource TextBrush}" StrokeThickness="2"
                              Data="M 7,0 L 7,14 M 0,7 L 14,7"/>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding IndentSelectedCommand}" ToolTip="Indent (Tab)">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource TextBrush}" StrokeThickness="2"
                              Data="M 0,2 L 10,2 M 0,7 L 6,7 M 8,4 L 12,7 L 8,10 M 0,12 L 10,12"/>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding OutdentSelectedCommand}" ToolTip="Outdent (Shift+Tab)">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource TextBrush}" StrokeThickness="2"
                              Data="M 0,2 L 10,2 M 4,7 L 10,7 M 6,4 L 2,7 L 6,10 M 0,12 L 10,12"/>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding DeleteSelectedCommand}" ToolTip="Delete Task (Del)">
                        <Path Width="13" Height="14" Stretch="Uniform" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6"
                              Data="M 0,3 L 13,3 M 4,3 L 4,0 L 9,0 L 9,3 M 2,3 L 2.7,14 L 10.3,14 L 11,3"/>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Style="{StaticResource RailButton}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)">
                        <Path Width="15" Height="12" Stretch="Uniform" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6"
                              Data="M 1,3 C 6,-1 13,0 14,6 C 13,11 6,12 1,8 M 1,8 L 1,4 M 1,8 L 5,8"/>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)">
                        <Path Width="15" Height="12" Stretch="Uniform" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6"
                              Data="M 14,3 C 9,-1 2,0 1,6 C 2,11 9,12 14,8 M 14,8 L 14,4 M 14,8 L 10,8"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Top bar -->
        <Border Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Project.Name}" Foreground="{StaticResource TextBrush}"
                           FontSize="14" VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             KeyDown="SearchBox_KeyDown"/>
                    <Button Content="Search" Margin="8,0,0,0" Style="{StaticResource DangerButton}"
                            Command="{Binding SearchCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Task list -->
        <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource PanelBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Task / Section" Style="{StaticResource PanelLabel}" Margin="10,10,0,6"/>
                <TreeView x:Name="TaskTree" Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding RootNodes}"
                          ItemTemplate="{StaticResource TaskNodeTemplate}"
                          SelectedItemChanged="TaskTree_SelectedItemChanged"/>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="2" Grid.Row="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush2}"/>

        <!-- Canvas placeholder (Phase 3) -->
        <Border Grid.Column="3" Grid.Row="1" Background="#FF19191E">
            <Grid>
                <TextBlock Text="Gantt canvas — coming in Phase 3" Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="4" Grid.Row="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush2}"/>

        <!-- Properties panel -->
        <Border Grid.Column="5" Grid.Row="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,0,0,0">
            <Grid>
                <TextBlock Text="Select a task to see its properties" Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           Width="220">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Properties.HasSelection}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10"
                              Visibility="{Binding Properties.HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DataContext="{Binding Properties}">
                        <TextBlock Text="Task Properties" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,8"/>

                        <TextBlock Text="TASK NAME" Style="{StaticResource PanelLabel}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                        <DockPanel Margin="0,12,0,0">
                            <TextBlock Text="Milestone" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding IsMilestone}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="START DATE" Style="{StaticResource PanelLabel}"/>
                        <DatePicker SelectedDate="{Binding StartDate}"/>

                        <TextBlock Text="END DATE" Style="{StaticResource PanelLabel}"/>
                        <DatePicker SelectedDate="{Binding EndDate}" IsEnabled="{Binding IsMilestone, Converter={StaticResource InverseBool}}"/>

                        <TextBlock Text="DURATION (DAYS)" Style="{StaticResource PanelLabel}"/>
                        <TextBox Text="{Binding DurationDays, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsMilestone, Converter={StaticResource InverseBool}}"/>

                        <TextBlock Text="SECTION" Style="{StaticResource PanelLabel}"/>
                        <TextBox Text="{Binding SectionDisplay, Mode=OneWay}" IsReadOnly="True" Opacity="0.7"/>

                        <TextBlock Text="COLOR" Style="{StaticResource PanelLabel}"/>
                        <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="PRIORITY" Style="{StaticResource PanelLabel}"/>
                        <ComboBox ItemsSource="{Binding PriorityLevels}" SelectedItem="{Binding Priority}"/>

                        <TextBlock Text="PROGRESS (%)" Style="{StaticResource PanelLabel}"/>
                        <TextBox Text="{Binding ProgressPercent, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="DESCRIPTION" Style="{StaticResource PanelLabel}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="70"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Delete Task" Style="{StaticResource DangerButton}"
                                    Margin="0,0,4,0"
                                    Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Grid.Column="1" Content="Save" Style="{StaticResource PrimaryButton}"
                                    Margin="4,0,0,0" Command="{Binding SaveCommand}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
