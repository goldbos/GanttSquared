<Window x:Class="GanttSquared.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GanttSquared.ViewModels"
        xmlns:conv="clr-namespace:GanttSquared.Converters"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        Title="GanttSquared" Height="720" Width="1280"
        Background="#FF17181C"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:DepthToIndentConverter x:Key="DepthToIndent"/>
        <conv:DoubleToLeftMarginConverter x:Key="DoubleToLeftMargin"/>
        <conv:ExpandGlyphConverter x:Key="ExpandGlyph"/>
        <conv:AllTrueToVisibilityConverter x:Key="AllTrueToVisibility"/>
        <conv:DarkThemeLabelConverter x:Key="DarkThemeLabel"/>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>
        <conv:BoolToRailWidthConverter x:Key="BoolToRailWidth"/>
        <!--
          Theme toggle: MainWindow.xaml.cs's ToggleTheme mutates each of these SolidColorBrush
          instances' own Color property rather than swapping which resource a key points to.
          Every {StaticResource X} reference below got its brush INSTANCE once at load time and
          keeps that same reference forever, but SolidColorBrush.Color is itself a dependency
          property - changing it repaints everything using that brush immediately, with no need
          to convert this whole file to DynamicResource.
        -->
        <!--
          These used to sit within a ~15-value-wide band of near-black grays (#17181C..#34353D),
          which read as everything blending into one surface with barely-there seams between the
          rail, panels, canvas and fields. Spread further apart on purpose: window chrome darkest,
          canvas darker still (a recessed "well" for the chart), panels/fields distinctly lighter
          steps, borders bright enough to actually read as dividers.
        -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF101114" po:Freeze="False"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF191A1F" po:Freeze="False"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#FF212228" po:Freeze="False"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#FF3C3E4A" po:Freeze="False"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFE8E9ED" po:Freeze="False"/>
        <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#FF2C2E38" po:Freeze="False"/>
        <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FF121319" po:Freeze="False"/>

        <!--
          The default TreeViewItem template (untouched below - we only set Background/
          Foreground/Padding on it, not its Template) uses these SystemColors keys for a
          selected row's background/foreground when the TreeView doesn't have keyboard
          focus - e.g. right after clicking into the Properties panel. The system default
          for "selected but inactive" is a light grey, which is unreadable against our
          hardcoded light row text. Overriding the keys here (not the template) keeps a
          legible dark-theme color in both the focused and unfocused-selected states.
        -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF3B82F6"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF3C3E4A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFE8E9ED"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3C3E4A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFE8E9ED"/>
        <!--
          The DatePicker calendar's previous/next arrow glyphs turned out to be near-invisible
          against the dark popup: they're drawn with a Path whose Fill comes from
          SystemColors.WindowTextBrushKey (a different key than the ControlTextBrushKey already
          overridden above for the TreeView), which defaults to near-black. Left alone, a
          near-black arrow on our near-black popup background reads as blank.
        -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFE8E9ED"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF9AA0AC"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9AA0AC" po:Freeze="False"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF3B82F6"/>
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#FF3A3B42" po:Freeze="False"/>
        <SolidColorBrush x:Key="RowAltBrush" Color="#FF2E313D" po:Freeze="False"/>
        <!-- Dependency link lines: lighter so they stand out against the near-black dark canvas, darker so they read against the light one. -->
        <SolidColorBrush x:Key="LinkLineBrush" Color="#FF8B94A6" po:Freeze="False"/>
        <SolidColorBrush x:Key="OverdueBrush" Color="#FFEF4444"/>
        <SolidColorBrush x:Key="ConflictBrush" Color="#FFF59E0B"/>

        <!-- Icon-only when condensed; when IsRailExpanded, stretches to fill the wider rail
             column and left-aligns its content so the icon+label pair (added per-button in the
             rail markup below) reads naturally instead of staying centered in extra space. -->
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="6,3"/>
            <Setter Property="Padding" Value="11,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF2E2F37"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same look as RailButton, but for a ToggleButton (Project Properties) - can't BasedOn
             RailButton since Button and ToggleButton are siblings under ButtonBase, not one a
             subtype of the other, so the template is duplicated with an added IsChecked trigger. -->
        <Style x:Key="RailToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="6,3"/>
            <Setter Property="Padding" Value="11,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF2E2F37"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF2E2F37"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label shown next to a rail icon only when the rail is expanded; DataContext flows
             down from the Window (MainViewModel) same as everything else in the rail. -->
        <Style x:Key="RailButtonLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="{Binding IsRailExpanded, Converter={StaticResource BoolToVisibility}}"/>
        </Style>

        <!-- App-wide flat scrollbar (no implicit x:Key, so it applies to every ScrollViewer's
             internal ScrollBar automatically) - thumb-only, no arrow buttons, colors pulled from
             the same theme brushes as everything else so it swaps with dark/light instead of
             falling back to the OS's default chrome. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <!-- IsDirectionReversed="True": without it, a vertical Track increases
                                 Value from bottom to top - dragging the thumb down would scroll
                                 up. Minimum/Maximum/Value/ViewportSize/Orientation don't need
                                 explicit TemplateBindings here: ScrollBar.OnApplyTemplate finds
                                 this Track by its "PART_Track" name and wires all of those up
                                 itself, which is the one part of this template that's easy to
                                 assume needs doing by hand and isn't. -->
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBg" Background="{DynamicResource BorderBrush2}"
                                                        CornerRadius="5" Margin="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBg" Property="Background" Value="{DynamicResource MutedTextBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBg" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- A vertical scrollbar needs a thin Width (its thickness) with Height left
                     alone so it stretches to fill its container; a horizontal one needs the
                     opposite. Setting both dimensions unconditionally to a fixed 11px - the
                     previous version of this style - collapsed every vertical scrollbar down to
                     an 11px-tall sliver instead of the full track height, which is what made the
                     task list's scrollbar look completely nonfunctional. -->
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="11"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="11"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <!-- Project title, editable in place: reads as plain largeish text until hovered/focused,
             when a faint background appears as the only hint it's actually a TextBox. -->
        <Style x:Key="TitleTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bg" Background="{DynamicResource BorderBrush2}" Opacity="0" CornerRadius="4"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF34353D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Background="{TemplateBinding Background}"
                                          BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource MutedTextBrush}"
                                                      StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center" HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                        BorderThickness="1" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                                        SnapsToDevicePixels="True">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          The DatePicker's popup Calendar inherits Foreground from the DatePicker itself
          (light, for the dark theme), but CalendarDayButton's default template has its own
          hardcoded light/white background unrelated to Calendar.Background - hence white
          day numbers on a white cell. CalendarDayButtonStyle/CalendarButtonStyle are the
          properties DatePicker/Calendar expose specifically for restyling those cells.
        -->
        <Style x:Key="DarkCalendarDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="3" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF34353D"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsBlackedOut" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCalendarButtonStyle" TargetType="CalendarButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF34353D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          CalendarDayButtonStyle/CalendarButtonStyle (above) only cover the month grid and the
          year/month picker grid. The header ("September 2026") text does inherit Foreground
          correctly. The previous/next arrow glyphs, however, are drawn by a Path baked directly
          into WPF's internal CalendarItem control template with its own explicit (non-implicit)
          style/local values for fill and chrome - confirmed by testing that neither an implicit
          Button style nor SystemColors overrides reach them at all. Recoloring them for real
          would require replacing that whole internal template (WPF exposes no style/brush hook
          for just the arrows), which is a large enough undertaking that it's being left as a
          known follow-up rather than risking a half-working custom Calendar template here.
        -->
        <Style x:Key="DarkCalendarStyle" TargetType="Calendar">
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DarkCalendarDayButtonStyle}"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource DarkCalendarButtonStyle}"/>
        </Style>

        <!--
          DatePickerTextBox (the inline editable field, not the popup) has its own default
          template with a hardcoded light background unrelated to the outer DatePicker's
          Background setter - same root cause as the calendar day buttons above, just for the
          text field instead of the popup. Only Foreground inherits down into it, so the date
          text itself was rendering light-on-light.
        -->
        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                            <TextBox x:Name="PART_TextBox"
                                     Text="{Binding Path=Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource TextBrush}"
                                     Padding="6,5"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CalendarStyle" Value="{StaticResource DarkCalendarStyle}"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Despite the name (a holdover from its first use), this is just the app's secondary/
             neutral button look - Background/Foreground swap with the theme via DynamicResource,
             unlike PrimaryButton's fixed AccentBrush+White (a saturated accent color reads fine
             in both themes, but a hardcoded dark grey box with white text does not - it read as
             a jarring black square in light mode before this). -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- Pill tab: active tab gets a solid accent-filled rounded pill; inactive tabs are
             plain text with a faint hover background. Each tab button's own Style (BasedOn this)
             adds the DataTrigger that sets Background/Foreground when it's the active tab. -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource FieldBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flattened task-list row (shared row order/height with the Gantt canvas so rows line up) -->
        <Style x:Key="RowToggleButton" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TaskRowTemplate" DataType="{x:Type vm:TaskNodeViewModel}">
            <Grid Height="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                  MouseEnter="TaskRow_MouseEnter" MouseLeave="TaskRow_MouseLeave">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="{Binding Depth, Converter={StaticResource DepthToIndent}}"/>
                    <Button Style="{StaticResource RowToggleButton}"
                            Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="9">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource ExpandGlyph}">
                                    <Binding Path="IsGroup"/>
                                    <Binding Path="IsExpanded"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Button>
                </StackPanel>

                <!-- Task-color dot; swaps to a diamond of the same color for milestones. -->
                <Ellipse Grid.Column="1" Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{Binding BarColorHex, Converter={StaticResource HexToBrush}}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMilestone}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Path Grid.Column="1" Width="9" Height="9" Stretch="Uniform"
                      Data="M 0.5,0.5 L 1,0 L 1.5,0.5 L 1,1 Z" VerticalAlignment="Center"
                      Fill="{Binding BarColorHex, Converter={StaticResource HexToBrush}}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMilestone}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <Grid Grid.Column="2" Margin="8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding WbsCode}" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WbsCode}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsEditingName, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <TextBox x:Name="InlineRenameBox" Grid.Column="1" Margin="-2,2,4,2" VerticalAlignment="Center"
                             Text="{Binding EditingNameDraft, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVisibility}}"
                             KeyDown="InlineRenameBox_KeyDown" LostFocus="InlineRenameBox_LostFocus"/>
                </Grid>
                <!-- Date text normally; swaps to a jump-to-chart button on hover, on the
                     opposite side of the row from the task name. -->
                <Grid Grid.Column="3" Margin="10,0,10,0">
                    <TextBlock Text="{Binding DateRangeText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"
                               Visibility="{Binding IsHovered, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <Button Style="{StaticResource RowToggleButton}" Click="JumpToTaskButton_Click"
                            ToolTip="Jump to this task on the chart"
                            Visibility="{Binding IsHovered, Converter={StaticResource BoolToVisibility}}">
                        <Path Width="10" Height="10" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"
                              Data="M 0,5 L 8,5 M 4,1 L 8,5 L 4,9"/>
                    </Button>
                </Grid>

                <Border Grid.Column="0" Grid.ColumnSpan="4" VerticalAlignment="Bottom" Height="1"
                        Background="{DynamicResource BorderBrush2}"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="TaskListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAlternateRow}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowAltBrush}"/>
                            </DataTrigger>
                            <!-- IsHovered mirrors hovering the bar on the canvas back onto this row, not just IsMouseOver's own direct hover. -->
                            <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource FieldBackgroundBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource FieldBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Alternating row background plus a full-width bottom divider, painted behind the Gantt bars and aligned to the same VisibleRows order -->
        <!-- Row stripes deliberately removed from the canvas (kept on the task list, where they
             still help you track a row across a wide window) - the canvas gets its visual
             structure from the week-boundary gridlines instead (see GridlineTemplate) rather
             than alternating backgrounds. -->
        <DataTemplate x:Key="CanvasRowStripeTemplate" DataType="{x:Type vm:TaskNodeViewModel}">
            <Grid Width="{Binding DataContext.CanvasWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                  Height="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderBrush2}"/>
            </Grid>
        </DataTemplate>

        <!-- Resources tab's allocation timeline: row stripe, task bar. Same layered-canvas
             approach as the Gantt chart's own templates just above, sized off
             ResourceCanvasWidth/Height instead of CanvasWidth/Height. -->
        <DataTemplate x:Key="ResourceRowStripeTemplate" DataType="{x:Type vm:ResourceRowViewModel}">
            <Grid Width="{Binding DataContext.ResourceCanvasWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                  Height="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderBrush2}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ResourceBarTemplate" DataType="{x:Type vm:ResourceAllocationBarViewModel}">
            <Border Height="{Binding Height}" Width="{Binding Width}" CornerRadius="4"
                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                    ToolTip="{Binding TaskName}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ConflictBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

        <!-- Gantt bar / milestone diamond. No Button wrapper: the root Grid handles its own
             mouse-down/move/up in code-behind so it can distinguish a plain click (select) from
             a drag starting in its middle (move) or within ~6px of an edge (resize). -->
        <DataTemplate x:Key="GanttBarTemplate" DataType="{x:Type vm:TaskNodeViewModel}">
            <Grid x:Name="BarRoot" Height="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                  Background="Transparent" ToolTip="{Binding Name}"
                  MouseLeftButtonDown="Bar_MouseLeftButtonDown"
                  MouseMove="Bar_MouseMove"
                  MouseLeftButtonUp="Bar_MouseLeftButtonUp"
                  MouseEnter="TaskRow_MouseEnter"
                  MouseLeave="TaskRow_MouseLeave">
                <!-- Full span, solid color. Progress % is still tracked on the task (shown in the
                     Properties panel and, on hover, a small badge above the bar) but is no longer
                     rendered as a fill split on the bar itself. An overdue task (past its end date
                     and not 100% complete) gets a red outline. -->
                <Border Height="{Binding DataContext.BarHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                        CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Width="{Binding BarWidth}" Background="{Binding BarColorHex, Converter={StaticResource HexToBrush}}"
                        IsHitTestVisible="False">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                            <Binding Path="IsMilestone" Converter="{StaticResource InverseBool}"/>
                            <Binding Path="IsGroup" Converter="{StaticResource InverseBool}"/>
                        </MultiBinding>
                    </Border.Visibility>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource OverdueBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsResourceConflict}" Value="True">
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ConflictBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Group/section "summary bar": a thin bracket spanning the rolled-up child date
                     range, with downward-pointing end caps - the standard Gantt convention for
                     "this is a structural rollup, not a real task with its own duration" (MS
                     Project, GanttProject, etc. all draw summary rows this way). Deliberately
                     undecorated by overdue/conflict outlines, unlike a real task's bar - a group's
                     Progress is never independently tracked, so it would otherwise misleadingly
                     show every past-due group as "overdue". -->
                <Border Height="7" CornerRadius="1.5" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Width="{Binding BarWidth}" Background="{Binding BarColorHex, Converter={StaticResource HexToBrush}}"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}"/>
                <Path Width="11" Height="9" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="-5,1,0,0" Data="M 0,0 L 11,0 L 5.5,9 Z"
                      Fill="{Binding BarColorHex, Converter={StaticResource HexToBrush}}"
                      IsHitTestVisible="False"
                      Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}"/>
                <Path Width="11" Height="9" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Data="M 0,0 L 11,0 L 5.5,9 Z"
                      Fill="{Binding BarColorHex, Converter={StaticResource HexToBrush}}"
                      IsHitTestVisible="False"
                      Margin="{Binding BarWidth, Converter={StaticResource DoubleToLeftMargin}}"
                      Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}"/>
                <Path Width="15" Height="15" Stretch="Uniform" Margin="-7,0,0,0" HorizontalAlignment="Left"
                      Data="M 7.5,0 L 15,7.5 L 7.5,15 L 0,7.5 Z"
                      Fill="{Binding BarColorHex, Converter={StaticResource HexToBrush}}"
                      IsHitTestVisible="False"
                      Visibility="{Binding IsMilestone, Converter={StaticResource BoolToVisibility}}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="StrokeThickness" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                    <Setter Property="StrokeThickness" Value="1.5"/>
                                    <Setter Property="Stroke" Value="{DynamicResource OverdueBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsResourceConflict}" Value="True">
                                    <Setter Property="StrokeThickness" Value="1.5"/>
                                    <Setter Property="Stroke" Value="{DynamicResource ConflictBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <!-- Progress % badge: hover-only, sits just above the bar's left edge. -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,-20,0,0"
                        Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="3" Padding="5,1" IsHitTestVisible="False">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                            <Binding Path="IsMouseOver" ElementName="BarRoot"/>
                            <Binding Path="IsMilestone" Converter="{StaticResource InverseBool}"/>
                        </MultiBinding>
                    </Border.Visibility>
                    <TextBlock Text="{Binding Task.ProgressPercent, StringFormat={}{0}%}"
                               Foreground="{DynamicResource TextBrush}" FontSize="10"/>
                </Border>

                <!-- Highlight overlay: IsHovered is set from either the list row or this bar
                     itself, so hovering the task in the list highlights its bar here too. -->
                <Border Height="{Binding DataContext.BarHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                        CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Width="{Binding BarWidth}" BorderBrush="White" BorderThickness="2"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsHovered, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMilestone}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Path Width="19" Height="19" Stretch="Uniform" Margin="-9,0,0,0" HorizontalAlignment="Left"
                      Data="M 9.5,0 L 19,9.5 L 9.5,19 L 0,9.5 Z"
                      Stroke="White" StrokeThickness="1.5"
                      IsHitTestVisible="False">
                    <Path.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                            <Binding Path="IsHovered"/>
                            <Binding Path="IsMilestone"/>
                        </MultiBinding>
                    </Path.Visibility>
                </Path>

                <!-- Dependency-link handle: hover-only, sits just past the bar's right edge; dragging from it onto another bar creates a link. -->
                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" Stroke="White" StrokeThickness="1"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Cross"
                         Margin="{Binding BarWidth, Converter={StaticResource DoubleToLeftMargin}}"
                         MouseLeftButtonDown="LinkHandle_MouseLeftButtonDown"
                         MouseMove="LinkHandle_MouseMove"
                         MouseLeftButtonUp="LinkHandle_MouseLeftButtonUp">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=BarRoot}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>
        </DataTemplate>

        <!-- Timeline header tick -->
        <DataTemplate x:Key="TimelineTickTemplate" DataType="{x:Type vm:TimelineTick}">
            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="4,10,0,0"/>
        </DataTemplate>

        <!-- Vertical gridline at each tick, spanning the full canvas height -->
        <!-- A tick that lands on a Monday gets a thicker, fully-opaque line marking the start of
             a new week; every other tick stays the thin, subtle divider it always was. In Week
             tick mode this never fires - BuildTicks walks week starts from StartOfWeek, which
             lands on Sunday, so no tick in that mode is ever a Monday - which is exactly the
             "only meaningful in Day mode" behavior wanted, with no extra mode-checking needed. -->
        <DataTemplate x:Key="GridlineTemplate" DataType="{x:Type vm:TimelineTick}">
            <Rectangle Fill="{DynamicResource BorderBrush2}"
                       Height="{Binding DataContext.CanvasHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Width" Value="1"/>
                        <Setter Property="Opacity" Value="0.9"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Date.DayOfWeek}" Value="Monday">
                                <Setter Property="Width" Value="2"/>
                                <Setter Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
        </DataTemplate>

        <DataTemplate x:Key="ResourceGridlineTemplate" DataType="{x:Type vm:TimelineTick}">
            <Rectangle Fill="{DynamicResource BorderBrush2}"
                       Height="{Binding DataContext.ResourceCanvasHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Width" Value="1"/>
                        <Setter Property="Opacity" Value="0.9"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Date.DayOfWeek}" Value="Monday">
                                <Setter Property="Width" Value="2"/>
                                <Setter Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
        </DataTemplate>

        <!-- Dependency connector: elbow path plus arrowhead, with a wide invisible hit path
             (thin lines are hard to click precisely) so clicking anywhere near it removes it -
             safe as a direct click since it's a single undoable action, same as everything else. -->
        <DataTemplate x:Key="DependencyLineTemplate" DataType="{x:Type vm:DependencyLineViewModel}">
            <Canvas>
                <Path x:Name="HitPath" Data="{Binding PathData}" Stroke="Transparent" StrokeThickness="10"
                      Cursor="Hand" ToolTip="Click to remove this dependency"
                      MouseLeftButtonDown="DependencyLine_MouseLeftButtonDown"/>
                <Path Data="{Binding PathData}" IsHitTestVisible="False" StrokeThickness="1.4">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Stroke" Value="{DynamicResource LinkLineBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=HitPath}" Value="True">
                                    <Setter Property="Stroke" Value="#FFEF4444"/>
                                    <Setter Property="StrokeThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <Polygon Points="{Binding ArrowPoints}" IsHitTestVisible="False">
                    <Polygon.Style>
                        <Style TargetType="Polygon">
                            <Setter Property="Fill" Value="{DynamicResource LinkLineBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=HitPath}" Value="True">
                                    <Setter Property="Fill" Value="#FFEF4444"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Polygon.Style>
                </Polygon>
            </Canvas>
        </DataTemplate>

        <Style x:Key="ZoomButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF34353D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResetZoomButtonStyle" TargetType="Button" BasedOn="{StaticResource ZoomButtonStyle}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding DataContext.IsRailExpanded, ElementName=RootWindow, Converter={StaticResource BoolToRailWidth}}"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Left icon rail -->
        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource RailButton}" Command="{Binding NewProjectCommand}" ToolTip="New Project (Ctrl+N)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                                  Data="M 2,1 L 8,1 L 12,5 L 12,13 L 2,13 Z M 8,1 L 8,5 L 12,5 M 4,8 L 10,8 M 4,10 L 10,10"/>
                            <TextBlock Text="New Project" Style="{StaticResource RailButtonLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding OpenProjectCommand}" ToolTip="Open Project... (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                                  Data="M 1,4 L 1,12 L 13,12 L 13,5 L 7,5 L 6,3 L 2,3 Z"/>
                            <TextBlock Text="Open Project" Style="{StaticResource RailButtonLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding ImportGanttProjectCommand}" ToolTip="Import GanttProject File (.gan)...">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                                  Data="M 7,1 L 7,9 M 3.5,5.5 L 7,9 L 10.5,5.5 M 1,11 L 1,13 L 13,13 L 13,11"/>
                            <TextBlock Text="Import .gan" Style="{StaticResource RailButtonLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding SaveProjectCommand}" ToolTip="Save Project (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                                  Data="M 1,1 L 10,1 L 13,4 L 13,13 L 1,13 Z M 3,1 L 3,5 L 10,5 L 10,1 M 3,13 L 3,8 L 10,8 L 10,13"/>
                            <TextBlock Text="Save" Style="{StaticResource RailButtonLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Click="ExportChart_Click" ToolTip="Export Chart as PNG or PDF...">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                                  Data="M 7,10 L 7,1 M 3.5,4.5 L 7,1 L 10.5,4.5 M 1,13 L 13,13"/>
                            <TextBlock Text="Export" Style="{StaticResource RailButtonLabel}"/>
                        </StackPanel>
                    </Button>
                    <Border Height="1" Margin="8,6" Background="{DynamicResource BorderBrush2}"/>

                    <Button Style="{StaticResource RailButton}" Command="{Binding NewTaskCommand}" ToolTip="New Task (Ins)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                  Data="M 7,0 L 7,14 M 0,7 L 14,7"/>
                            <TextBlock Text="New Task" Style="{StaticResource RailButtonLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding IndentSelectedCommand}" ToolTip="Indent (Tab)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                  Data="M 0,2 L 10,2 M 0,7 L 6,7 M 8,4 L 12,7 L 8,10 M 0,12 L 10,12"/>
                            <TextBlock Text="Indent" Style="{StaticResource RailButtonLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding OutdentSelectedCommand}" ToolTip="Outdent (Shift+Tab)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                  Data="M 0,2 L 10,2 M 4,7 L 10,7 M 6,4 L 2,7 L 6,10 M 0,12 L 10,12"/>
                            <TextBlock Text="Outdent" Style="{StaticResource RailButtonLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding DeleteSelectedCommand}" ToolTip="Delete Task (Del)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"
                                  Data="M 0,3 L 13,3 M 4,3 L 4,0 L 9,0 L 9,3 M 2,3 L 2.7,14 L 10.3,14 L 11,3"/>
                            <TextBlock Text="Delete" Style="{StaticResource RailButtonLabel}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Style="{StaticResource RailButton}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="12" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"
                                  Data="M 1,3 C 6,-1 13,0 14,6 C 13,11 6,12 1,8 M 1,8 L 1,4 M 1,8 L 5,8"/>
                            <TextBlock Text="Redo" Style="{StaticResource RailButtonLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="12" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"
                                  Data="M 14,3 C 9,-1 2,0 1,6 C 2,11 9,12 14,8 M 14,8 L 14,4 M 14,8 L 10,8"/>
                            <TextBlock Text="Undo" Style="{StaticResource RailButtonLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding ToggleDensityCommand}" ToolTip="Toggle Row Density (Compact/Comfortable)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"
                                  Data="M 0,2 L 14,2 M 0,7 L 14,7 M 0,12 L 14,12">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompactDensity}" Value="True">
                                                <Setter Property="Data" Value="M 0,1 L 14,1 M 0,4.5 L 14,4.5 M 0,8 L 14,8 M 0,11.5 L 14,11.5 M 0,15 L 14,15"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="Density" Style="{StaticResource RailButtonLabel}"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Margin="8,6" Background="{DynamicResource BorderBrush2}"/>

                    <Button Style="{StaticResource RailButton}" Command="{Binding ToggleRailExpandedCommand}" ToolTip="Expand/Collapse Sidebar">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M 4,1 L 10,7 L 4,13"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRailExpanded}" Value="True">
                                                <Setter Property="Data" Value="M 10,1 L 4,7 L 10,13"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RailButtonLabel}">
                                        <Setter Property="Text" Value="Expand"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRailExpanded}" Value="True">
                                                <Setter Property="Text" Value="Collapse"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Top bar -->
        <Border Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0" VerticalAlignment="Center">
                <!-- Project title and save-status now live only on the task list's own title row
                     (Gantt tab) - this bar's job is just view-switching plus WBS#/Search. -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Gantt" Command="{Binding ShowGanttTabCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Gantt">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Resources" Command="{Binding ShowResourcesTabCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Resources">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Dashboard" Command="{Binding ShowDashboardTabCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Dashboard">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="WBS #" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                              Margin="0,0,16,0" IsChecked="{Binding UseWbsNumbering}" ToolTip="Show WBS numbering (1, 1.1, 1.2, 2...) in the task list"/>
                    <TextBox Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             KeyDown="SearchBox_KeyDown"/>
                    <Button Content="Search" Margin="8,0,0,0" Style="{StaticResource DangerButton}"
                            Command="{Binding SearchCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Task list -->
        <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource PanelBrush}"
                Visibility="{Binding ActiveTab, Converter={StaticResource EnumEquals}, ConverterParameter=Gantt}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Document title row: project name (click to rename), file-properties button, save-status dot -->
                <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
                    <DockPanel Margin="10,0,8,0" LastChildFill="True">
                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                 ToolTip="Saved locally">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF22C55E"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                            <Setter Property="Fill" Value="#FFF59E0B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <!-- Local-file glyph (no cloud sync exists in this app, so this always reads as "saved on this computer") -->
                        <Path DockPanel.Dock="Left" Data="M1,1 L13,1 L13,9 L1,9 Z M4,11 L10,11 M7,9 L7,11"
                              Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2"
                              Width="14" Height="12" Margin="0,0,10,0" VerticalAlignment="Center"
                              ToolTip="Saved locally"/>

                        <!-- "Settings sliders" glyph (three rows, each a line with an offset knob) -
                             reads unambiguously as "open settings/properties" at small sizes,
                             unlike the gear silhouette this replaces which turned into a blob. -->
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource RailToggleButtonStyle}"
                                      IsChecked="{Binding IsFilePropertiesOpen, Mode=OneWay}"
                                      Command="{Binding ToggleFilePropertiesCommand}"
                                      ToolTip="File Properties" Width="24" Height="24" Padding="0">
                            <Canvas Width="14" Height="14">
                                <Line X1="0" Y1="2" X2="14" Y2="2" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3"/>
                                <Ellipse Canvas.Left="8" Canvas.Top="0.5" Width="3" Height="3" Fill="{DynamicResource TextBrush}"/>
                                <Line X1="0" Y1="7" X2="14" Y2="7" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3"/>
                                <Ellipse Canvas.Left="3" Canvas.Top="5.5" Width="3" Height="3" Fill="{DynamicResource TextBrush}"/>
                                <Line X1="0" Y1="12" X2="14" Y2="12" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3"/>
                                <Ellipse Canvas.Left="9.5" Canvas.Top="10.5" Width="3" Height="3" Fill="{DynamicResource TextBrush}"/>
                            </Canvas>
                        </ToggleButton>

                        <!-- LostFocus, not PropertyChanged: ProjectName trims on every set, and
                             with a live per-keystroke binding that trim fires mid-typing too -
                             stripping the trailing space the moment you type one, so a multi-word
                             name could never actually be entered. Committing on LostFocus/Enter
                             only avoids that; KeyDown just moves focus to trigger the commit. -->
                        <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource TitleTextBoxStyle}"
                                 VerticalAlignment="Center" ToolTip="Click to rename project"
                                 KeyDown="ProjectNameTextBox_KeyDown"/>
                    </DockPanel>
                </Border>

                <TextBlock Grid.Row="2" Text="Task / Section" Style="{StaticResource PanelLabel}"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button Content="Expand All" Style="{StaticResource ResetZoomButtonStyle}" Command="{Binding ExpandAllCommand}"/>
                    <Button Content="Collapse All" Style="{StaticResource ResetZoomButtonStyle}" Command="{Binding CollapseAllCommand}"/>
                </StackPanel>
                <Border Grid.Row="2" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderBrush2}"/>

                <ScrollViewer x:Name="TaskListScroll" Grid.Row="3"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="TaskList" ItemsSource="{Binding VisibleRows}" ItemTemplate="{StaticResource TaskRowTemplate}"
                             ItemContainerStyle="{StaticResource TaskListBoxItemStyle}"
                             SelectionMode="Extended" AllowDrop="True"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent" BorderThickness="0"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="2" Grid.Row="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush2}"
                      Visibility="{Binding ActiveTab, Converter={StaticResource EnumEquals}, ConverterParameter=Gantt}"/>

        <!-- Gantt canvas -->
        <Border Grid.Column="3" Grid.Row="1" Background="{DynamicResource CanvasBackgroundBrush}"
                Visibility="{Binding ActiveTab, Converter={StaticResource EnumEquals}, ConverterParameter=Gantt}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row aligns with the task list panel's title row (project name/rename/file
                     properties) to its left - it used to be a blank spacer purely for height
                     alignment, now it also holds the zoom toolbar so Row 1 below (which the task
                     list leaves blank at this same position) can stay blank on both sides. -->
                <Border Grid.Row="0" Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1"/>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="Today" Style="{StaticResource ResetZoomButtonStyle}"
                            Click="JumpToToday_Click" ToolTip="Jump to Today"/>
                    <Button Content="&#8722;" Style="{StaticResource ZoomButtonStyle}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom Out"/>
                    <Button Content="+" Style="{StaticResource ZoomButtonStyle}" Command="{Binding ZoomInCommand}" ToolTip="Zoom In"/>
                    <Button Content="Reset" Style="{StaticResource ResetZoomButtonStyle}"
                            Command="{Binding ResetZoomCommand}" ToolTip="Reset Zoom"/>
                </StackPanel>

                <!-- Timeline header (horizontal scroll only, synced to the canvas body) -->
                <Border Grid.Row="2" Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,1">
                    <ScrollViewer x:Name="HeaderScroll" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Hidden" IsHitTestVisible="False">
                        <ItemsControl x:Name="HeaderContent" ItemsSource="{Binding Timeline.Ticks}" ItemTemplate="{StaticResource TimelineTickTemplate}"
                                      HorizontalAlignment="Left" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="{Binding CanvasWidth}" Height="32"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Canvas body: gridlines, alternating row stripes, dependency lines, bars, today marker -->
                <!-- Both scrollbars hidden here on purpose: vertical now shows on the task list's
                     own right edge instead (closer to what you're actually reading), and
                     horizontal is dropped entirely now that the range silently extends as you
                     approach either edge (drag-pan, Ctrl+scroll zoom, and the Today button cover
                     navigation without it). Both ScrollViewers stay functional - Hidden, not
                     Disabled - this only hides the bars themselves. -->
                <ScrollViewer x:Name="CanvasScroll" Grid.Row="3" Background="Transparent"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                    <Grid x:Name="CanvasBodyGrid" Background="Transparent">
                        <ItemsControl ItemsSource="{Binding VisibleRows}" ItemTemplate="{StaticResource CanvasRowStripeTemplate}"
                                      HorizontalAlignment="Left" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Top" Value="{Binding RowTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Timeline.Ticks}" ItemTemplate="{StaticResource GridlineTemplate}"
                                      HorizontalAlignment="Left" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding DependencyLines}" ItemTemplate="{StaticResource DependencyLineTemplate}"
                                      HorizontalAlignment="Left" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Rectangle Width="1.5" Fill="#FFEF4444" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Height="{Binding CanvasHeight}"
                                   Margin="{Binding Timeline.TodayX, Converter={StaticResource DoubleToLeftMargin}}"/>

                        <ItemsControl ItemsSource="{Binding VisibleRows}" ItemTemplate="{StaticResource GanttBarTemplate}"
                                      HorizontalAlignment="Left" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding BarX}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding RowTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <!-- Live rubber-band preview while dragging a dependency link from one bar to another -->
                        <Line X1="{Binding DragLinkX1}" Y1="{Binding DragLinkY1}" X2="{Binding DragLinkX2}" Y2="{Binding DragLinkY2}"
                              StrokeThickness="2" StrokeDashArray="4,2"
                              Visibility="{Binding IsDraggingLink, Converter={StaticResource BoolToVisibility}}">
                            <Line.Style>
                                <Style TargetType="Line">
                                    <Setter Property="Stroke" Value="#FFEF4444"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DragLinkIsValid}" Value="True">
                                            <Setter Property="Stroke" Value="#FF22C55E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Line.Style>
                        </Line>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="4" Grid.Row="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush2}"
                      Visibility="{Binding ActiveTab, Converter={StaticResource EnumEquals}, ConverterParameter=Gantt}"/>

        <!-- Properties panel. Uses PanelAltBrush (not PanelBrush, which the task list to its left
             already uses) plus a cast shadow to visually lift it off the canvas, and its own
             header bar, so it reads as a distinct, purposeful panel rather than more of the same
             grey continuing past the canvas. -->
        <Border Grid.Column="5" Grid.Row="1" Background="{DynamicResource PanelAltBrush}"
                Visibility="{Binding ActiveTab, Converter={StaticResource EnumEquals}, ConverterParameter=Gantt}">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="180" ShadowDepth="6" BlurRadius="18" Opacity="0.35"/>
            </Border.Effect>
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="16,14">
                    <TextBlock Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Task Properties"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Properties.HasSelection}" Value="False">
                                        <Setter Property="Text" Value="Properties"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Properties.IsBulkMode}" Value="True">
                                        <Setter Property="Text" Value="{Binding Properties.BulkTaskCount, StringFormat='{}{0} Tasks Selected'}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFilePropertiesOpen}" Value="True">
                                        <Setter Property="Text" Value="File Properties"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Grid>
                    <TextBlock Text="Select a task to see its properties" Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               Width="220">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Properties.HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFilePropertiesOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- File Properties: same TIMELINE/APPEARANCE content that used to live in the
                         gear-icon flyout, now shown in this pane instead (mutually exclusive with
                         task selection - opening this clears the selection, and vice versa). -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14"
                                  Visibility="{Binding IsFilePropertiesOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="TIMELINE" Style="{StaticResource PanelLabel}"/>

                            <TextBlock Text="RANGE START" Style="{StaticResource PanelLabel}" Margin="0,10,0,4"/>
                            <DatePicker SelectedDate="{Binding Timeline.RangeStartDate}"/>

                            <TextBlock Text="RANGE END" Style="{StaticResource PanelLabel}"/>
                            <DatePicker SelectedDate="{Binding Timeline.RangeEndDate}"/>

                            <TextBlock Text="TICK MARKS" Style="{StaticResource PanelLabel}"/>
                            <ComboBox ItemsSource="{Binding Timeline.TickModes}" SelectedItem="{Binding Timeline.TickMode}"/>

                            <TextBlock Text="APPEARANCE" Style="{StaticResource PanelLabel}" Margin="0,20,0,4"/>
                            <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource ResetZoomButtonStyle}"
                                    HorizontalAlignment="Left" Padding="12,6"
                                    Content="{Binding IsDarkTheme, Converter={StaticResource DarkThemeLabel}}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Properties.HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFilePropertiesOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel DataContext="{Binding Properties}">
                            <!-- Single-task fields -->
                        <StackPanel Visibility="{Binding IsBulkMode, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="TASK NAME" Style="{StaticResource PanelLabel}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <DockPanel Margin="0,12,0,0">
                                <TextBlock Text="Milestone" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                <CheckBox IsChecked="{Binding IsMilestone}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="START DATE" Style="{StaticResource PanelLabel}"/>
                            <DatePicker SelectedDate="{Binding StartDate}"/>

                            <TextBlock Text="END DATE" Style="{StaticResource PanelLabel}"/>
                            <DatePicker SelectedDate="{Binding EndDate}" IsEnabled="{Binding IsMilestone, Converter={StaticResource InverseBool}}"/>

                            <TextBlock Text="DURATION (DAYS)" Style="{StaticResource PanelLabel}"/>
                            <TextBox Text="{Binding DurationDays, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsMilestone, Converter={StaticResource InverseBool}}"/>

                            <TextBlock Text="SECTION" Style="{StaticResource PanelLabel}"/>
                            <TextBox Text="{Binding SectionDisplay, Mode=OneWay}" IsReadOnly="True" Opacity="0.7"/>

                            <TextBlock Text="COLOR" Style="{StaticResource PanelLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>
                                <Border Grid.Column="1" Width="30" Height="30" Margin="6,0,0,0" CornerRadius="4"
                                        Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                        Cursor="Hand" ToolTip="Pick a color..."
                                        MouseLeftButtonUp="ColorSwatch_MouseLeftButtonUp"/>
                            </Grid>

                            <TextBlock Text="PRIORITY" Style="{StaticResource PanelLabel}"/>
                            <ComboBox ItemsSource="{Binding PriorityLevels}" SelectedItem="{Binding Priority}"/>

                            <TextBlock Text="PROGRESS (%)" Style="{StaticResource PanelLabel}"/>
                            <TextBox Text="{Binding ProgressPercent, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="DESCRIPTION" Style="{StaticResource PanelLabel}"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="70"/>

                            <TextBlock Text="NOTES" Style="{StaticResource PanelLabel}"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="70"/>

                            <TextBlock Text="RESOURCES" Style="{StaticResource PanelLabel}"/>
                            <ItemsControl ItemsSource="{Binding ResourceOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsAssigned}"
                                                  Foreground="{DynamicResource TextBrush}" Margin="0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No resources yet - add some from the Resources tab." Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResourceOptions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Bulk-edit fields: only checked fields are applied to every selected task on Save -->
                        <StackPanel Visibility="{Binding IsBulkMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Check a field to apply it to every selected task." Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <DockPanel Margin="0,12,0,4">
                                <CheckBox IsChecked="{Binding BulkApplyPriority}" VerticalAlignment="Center"/>
                                <TextBlock Text="PRIORITY" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding PriorityLevels}" SelectedItem="{Binding Priority}" IsEnabled="{Binding BulkApplyPriority}"/>

                            <DockPanel Margin="0,12,0,4">
                                <CheckBox IsChecked="{Binding BulkApplyColor}" VerticalAlignment="Center"/>
                                <TextBlock Text="COLOR" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid IsEnabled="{Binding BulkApplyColor}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>
                                <Border Grid.Column="1" Width="30" Height="30" Margin="6,0,0,0" CornerRadius="4"
                                        Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                        Cursor="Hand" ToolTip="Pick a color..."
                                        MouseLeftButtonUp="ColorSwatch_MouseLeftButtonUp"/>
                            </Grid>

                            <DockPanel Margin="0,12,0,4">
                                <CheckBox IsChecked="{Binding BulkApplyProgress}" VerticalAlignment="Center"/>
                                <TextBlock Text="PROGRESS (%)" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox Text="{Binding ProgressPercent, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding BulkApplyProgress}"/>
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Delete Task" Style="{StaticResource DangerButton}"
                                    Margin="0,0,4,0"
                                    Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Grid.Column="1" Content="Save" Style="{StaticResource PrimaryButton}"
                                    Margin="4,0,0,0" Command="{Binding SaveCommand}"/>
                        </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Resources view: a compact editable list (name/color/delete, with email+color in a
             details popup) plus an allocation timeline below - structured the same way as the
             Gantt tab (a fixed name column, a splitter, then a scrollable canvas with its own
             synced header), reading the same shared Timeline instance so both charts always
             agree on date range/zoom. Overlapping bars get the same amber conflict outline used
             on the main chart. -->
        <Grid Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="1"
              Visibility="{Binding ActiveTab, Converter={StaticResource EnumEquals}, ConverterParameter=Resources}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
                <DockPanel Margin="20,14">
                    <TextBlock Text="Resources" Foreground="{DynamicResource TextBrush}" FontSize="16" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="+ Add Resource" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Command="{Binding AddResourceCommand}"/>
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="No resources yet. Click &quot;+ Add Resource&quot; to create one."
                       Foreground="{DynamicResource MutedTextBrush}" Margin="24,70,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Resources.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Compact row list: name + color + warning + details/delete. -->
            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="RESOURCE" Style="{StaticResource PanelLabel}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderBrush2}"/>
                    <ScrollViewer x:Name="ResourceListScroll" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Resources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="12" Height="12" CornerRadius="6" Margin="2,0,8,0" VerticalAlignment="Center"
                                                Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"/>
                                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                                 BorderThickness="0" Background="Transparent" Padding="2"/>
                                        <TextBlock Grid.Column="2" Text="&#9888;" Foreground="{DynamicResource ConflictBrush}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="4,0"
                                                   ToolTip="This resource is assigned to two or more tasks with overlapping dates."
                                                   Visibility="{Binding IsOverallocated, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Grid.Column="3" x:Name="DetailsButton" Content="&#8942;" Style="{StaticResource DangerButton}"
                                                Width="22" Height="22" Margin="2,0" Padding="0" FontSize="12" VerticalAlignment="Center"
                                                ToolTip="Email, color, assigned tasks"
                                                Command="{Binding ToggleDetailsCommand}"/>
                                        <Button Grid.Column="4" Content="&#10005;" Style="{StaticResource DangerButton}"
                                                Width="22" Height="22" Margin="2,0,0,0" Padding="0" FontSize="10" VerticalAlignment="Center"
                                                ToolTip="Delete resource"
                                                Command="{Binding DataContext.DeleteResourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>

                                        <Popup PlacementTarget="{Binding ElementName=DetailsButton}" Placement="Bottom"
                                               IsOpen="{Binding IsDetailsExpanded}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                                    BorderThickness="1" CornerRadius="8" Padding="14" Width="230">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4"/>
                                                </Border.Effect>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                                    <TextBlock Text="EMAIL" Style="{StaticResource PanelLabel}" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="COLOR (HEX)" Style="{StaticResource PanelLabel}" Margin="0,10,0,4"/>
                                                    <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="{Binding AssignedTaskNames}" Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush2}"/>

            <!-- Allocation timeline canvas -->
            <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource CanvasBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Content="Today" Style="{StaticResource ResetZoomButtonStyle}"
                                Click="ResourceJumpToToday_Click" ToolTip="Jump to Today"/>
                        <Button Content="&#8722;" Style="{StaticResource ZoomButtonStyle}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom Out"/>
                        <Button Content="+" Style="{StaticResource ZoomButtonStyle}" Command="{Binding ZoomInCommand}" ToolTip="Zoom In"/>
                        <Button Content="Reset" Style="{StaticResource ResetZoomButtonStyle}"
                                Command="{Binding ResetZoomCommand}" ToolTip="Reset Zoom"/>
                    </StackPanel>

                    <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderBrush2}"/>

                    <ScrollViewer x:Name="ResourceHeaderScroll" Grid.Row="0" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Hidden" IsHitTestVisible="False">
                        <ItemsControl x:Name="ResourceHeaderContent" ItemsSource="{Binding Timeline.Ticks}" ItemTemplate="{StaticResource TimelineTickTemplate}"
                                      HorizontalAlignment="Left" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="{Binding ResourceCanvasWidth}" Height="28"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ResourceCanvasScroll" Grid.Row="1" Background="Transparent"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                        <Grid x:Name="ResourceCanvasBodyGrid" Background="Transparent">
                            <ItemsControl ItemsSource="{Binding Resources}" ItemTemplate="{StaticResource ResourceRowStripeTemplate}"
                                          HorizontalAlignment="Left" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding ResourceCanvasWidth}" Height="{Binding ResourceCanvasHeight}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Top" Value="{Binding RowTop}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Timeline.Ticks}" ItemTemplate="{StaticResource ResourceGridlineTemplate}"
                                          HorizontalAlignment="Left" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding ResourceCanvasWidth}" Height="{Binding ResourceCanvasHeight}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <Rectangle Width="1.5" Fill="#FFEF4444" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Height="{Binding ResourceCanvasHeight}"
                                       Margin="{Binding Timeline.TodayX, Converter={StaticResource DoubleToLeftMargin}}"/>

                            <ItemsControl ItemsSource="{Binding ResourceAllocationBars}" ItemTemplate="{StaticResource ResourceBarTemplate}"
                                          HorizontalAlignment="Left" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding ResourceCanvasWidth}" Height="{Binding ResourceCanvasHeight}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Dashboard: a project-wide summary snapshot (Dashboard.RebuildDashboard recomputes it
             on every edit), not an editable view - nothing here routes back through undo/redo. -->
        <Border Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="1" Background="{DynamicResource PanelBrush}"
                Visibility="{Binding ActiveTab, Converter={StaticResource EnumEquals}, ConverterParameter=Dashboard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding Dashboard}" Margin="20">
                    <TextBlock Text="Dashboard" Foreground="{DynamicResource TextBrush}" FontSize="16" Margin="0,0,0,16"/>

                    <!-- Headline stat cards -->
                    <UniformGrid Columns="4" Margin="0,0,0,20">
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalTasks}" Foreground="{DynamicResource TextBrush}" FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="Total Tasks" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCard}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{Binding CompletionPercent, StringFormat={}{0:0}%}" Foreground="{DynamicResource TextBrush}" FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="Complete" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCard}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{Binding OverdueCount}" FontSize="28" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource OverdueBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OverdueCount}" Value="0">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Overdue" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCard}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ConflictedResourceNames.Count}" FontSize="28" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource ConflictBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConflictedResourceNames.Count}" Value="0">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Resource Conflicts" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Status + priority breakdowns -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="TASKS BY STATUS" Style="{StaticResource PanelLabel}" Margin="0,0,0,8"/>
                                <DockPanel Margin="0,3" LastChildFill="False"><TextBlock Text="Not Started" Foreground="{DynamicResource TextBrush}"/><TextBlock DockPanel.Dock="Right" Text="{Binding NotStartedCount}" Foreground="{DynamicResource MutedTextBrush}"/></DockPanel>
                                <DockPanel Margin="0,3" LastChildFill="False"><TextBlock Text="In Progress" Foreground="{DynamicResource TextBrush}"/><TextBlock DockPanel.Dock="Right" Text="{Binding InProgressCount}" Foreground="{DynamicResource MutedTextBrush}"/></DockPanel>
                                <DockPanel Margin="0,3" LastChildFill="False"><TextBlock Text="Completed" Foreground="{DynamicResource TextBrush}"/><TextBlock DockPanel.Dock="Right" Text="{Binding CompletedCount}" Foreground="{DynamicResource MutedTextBrush}"/></DockPanel>
                                <DockPanel Margin="0,3" LastChildFill="False"><TextBlock Text="Overdue" Foreground="{DynamicResource OverdueBrush}"/><TextBlock DockPanel.Dock="Right" Text="{Binding OverdueCount}" Foreground="{DynamicResource OverdueBrush}"/></DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="TASKS BY PRIORITY" Style="{StaticResource PanelLabel}" Margin="0,0,0,8"/>
                                <DockPanel Margin="0,3" LastChildFill="False"><TextBlock Text="Low" Foreground="{DynamicResource TextBrush}"/><TextBlock DockPanel.Dock="Right" Text="{Binding LowPriorityCount}" Foreground="{DynamicResource MutedTextBrush}"/></DockPanel>
                                <DockPanel Margin="0,3" LastChildFill="False"><TextBlock Text="Medium" Foreground="{DynamicResource TextBrush}"/><TextBlock DockPanel.Dock="Right" Text="{Binding MediumPriorityCount}" Foreground="{DynamicResource MutedTextBrush}"/></DockPanel>
                                <DockPanel Margin="0,3" LastChildFill="False"><TextBlock Text="High" Foreground="{DynamicResource TextBrush}"/><TextBlock DockPanel.Dock="Right" Text="{Binding HighPriorityCount}" Foreground="{DynamicResource MutedTextBrush}"/></DockPanel>
                                <DockPanel Margin="0,3" LastChildFill="False"><TextBlock Text="Critical" Foreground="{DynamicResource TextBrush}"/><TextBlock DockPanel.Dock="Right" Text="{Binding CriticalPriorityCount}" Foreground="{DynamicResource MutedTextBrush}"/></DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- At-risk tasks + upcoming milestones -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="AT RISK (OVERDUE)" Style="{StaticResource PanelLabel}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding OverdueTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Date, StringFormat=MMM d}" Foreground="{DynamicResource OverdueBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nothing overdue." Foreground="{DynamicResource MutedTextBrush}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OverdueTasks.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="UPCOMING MILESTONES" Style="{StaticResource PanelLabel}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding UpcomingMilestones}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Date, StringFormat=MMM d}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No upcoming milestones." Foreground="{DynamicResource MutedTextBrush}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpcomingMilestones.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
