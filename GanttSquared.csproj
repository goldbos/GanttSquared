<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="GanttSquared.Core\GanttSquared.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="GanttSquared.Core\**\*.cs" />
    <Compile Remove="GanttSquared.Core.Tests\**\*.cs" />
    <EmbeddedResource Remove="GanttSquared.Core\**\*.*" />
    <EmbeddedResource Remove="GanttSquared.Core.Tests\**\*.*" />
    <Page Remove="GanttSquared.Core\**\*.xaml" />
    <Page Remove="GanttSquared.Core.Tests\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!--
    Only System.Windows.Forms.ColorDialog is needed (there's no WPF-native color picker), always
    referenced by its full name in code. UseWindowsForms=true would be the usual way to pull this
    in, but it also adds global implicit usings for System.Windows.Forms/System.Drawing, which
    collide with WPF's own Application/Point/MouseEventArgs/KeyEventArgs/DragEventArgs everywhere
    in this project. FrameworkReference gets the assembly without that side effect.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
